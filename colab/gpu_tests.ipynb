# @title 2. Download test audio samples
# We generate synthetic speech-like audio for testing
import numpy as np

def generate_test_audio(text_seed: str, duration: float = 5.0, sr: int = 16000) -> np.ndarray:
    """Generate synthetic audio that simulates speech patterns."""
    np.random.seed(hash(text_seed) % 2**31)
    n_samples = int(sr * duration)
    # Create modulated noise that resembles speech
    t = np.linspace(0, duration, n_samples)
    base = np.sin(2 * np.pi * 150 * t) * 0.3  # fundamental
    formant1 = np.sin(2 * pi * 500 * t) * 0.2  # vowel formant
    formant2 = np.sin(2 * pi * 1500 * t) * 0.1
    noise = np.random.normal(0, 0.05, n_samples)
    amplitude = np.abs(np.sin(2 * pi * 2 * t)) * 0.5 + 0.5  # syllable-like modulation
    audio = (base + formant1 + formant2 + noise) * amplitude
    return audio.astype(np.float32)

# @title 3. Benchmark Whisper inference speed
from faster_whisper import WhisperModel
import time

models_to_test = ["tiny", "base"]
results = {}

for model_size in models_to_test:
    print(f"\n--- Testing {model_size} ---")
    model = WhisperModel(model_size, device="cuda", compute_type="int8")
    audio = generate_test_audio("benchmark test", duration=10.0)

    start = time.time()
    segments, info = model.transcribe(audio, language="en")
    elapsed = time.time() - start

    text = " ".join(s.text for s in segments)
    rtf = elapsed / 10.0  # Real-time factor (lower = faster)

    results[model_size] = {
        "time_seconds": elapsed,
        "rtf": rtf,
        "model_size_mb": model_size,
        "device": "cuda",
    }

    print(f"  Time: {elapsed:.2f}s for 10s audio")
    print(f"  RTF: {rtf:.2f}x (< 1.0 = faster than real-time)")
    print(f"  Output: {text[:100]}...")

print("\n=== Benchmark Summary ===")
for size, r in sorted(results.items(), key=lambda x: x[1]["rtf"]):
    print(f"  {size:8s}: RTF={r['rtf']:.3f}x ({r['time_seconds']:.2f}s for 10s audio)")

# @title 4. Test LLM post-processor
import os

# Configure a free Groq API key for testing
# Or use: os.environ["GROQ_API_KEY"] = "your-key-here"

from voiceflow.llm_postprocessor import LLMPostProcessor, LLMConfig

# Test with dummy (disabled)
processor = LLMPostProcessor(LLMConfig(enabled=False))
raw_text = "um so basically what i wanted to say is that the project is going well"
result = processor.process(raw_text)
print(f"Disabled passthrough: {result}")

# Test with Groq if key available
if os.environ.get("GROQ_API_KEY"):
    processor = LLMPostProcessor(LLMConfig(
        enabled=True,
        api_key=os.environ["GROQ_API_KEY"],
        base_url="https://api.groq.com/openai/v1",
        model="llama-3.3-70b-versatile",
    ))
    result = processor.process(raw_text)
    print(f"LLM cleanup: {result}")
else:
    print("No GroQ API key set. Skipping LLM test.")

# @title 5. Test voice commands
from voiceflow.voice_commands import VoiceCommandProcessor

proc = VoiceCommandProcessor()
tests = [
    "hello world new line",
    "delete last word",
    "caps on",
    "period",
    "all caps important end caps",
    "just some normal text",
]

print("\n=== Voice Command Tests ===")
for text in tests:
    cmd, remaining = proc.process(text)
    if cmd:
        print(f"  '{text}' -> [{cmd.action}] remaining='{remaining}'")
    else:
        print(f"  '{text}' -> (no command)")

# @title 6. Test agent mode
from voiceflow.agent_mode import AgentMode

agent = AgentMode(auto_confirm=True)
tests = [
    "open firefox",
    "search the web for voice dictation apps",
    "start timer for 5 minutes",
    "set reminder in 10 minutes to check email",
]

print("\n=== Agent Mode Tests ===")
for text in tests:
    result = agent.process_transcript(text)
    if result:
        print(f"  '{text}'")
        print(f"    Action: {result['action_name']}")
        print(f"    Args: {result.get('args', {})}")
    else:
        print(f"  '{text}' -> (no match)")
